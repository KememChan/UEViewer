/******************************************************************************
 *	Per-pixel lighting shader with normalmap support
 *****************************************************************************/

// Debug modes
//#define SHOW_BUMP			// show only normalmap
//#define SHOW_SPECULAR		// show only specular component
//#define NORMALMAP			// show mesh using single light from viewer; no texuring, specular from everything
//#define WORLDNORMAL		// show world normals as color

#define SPECULAR

#ifndef DIFFUSE
#define DIFFUSE		0
#endif

#ifndef CUBE
#define CUBE		0
#endif

#ifdef SHOW_BUMP
#undef EMISSIVE
#endif

#ifndef EMISSIVE
#define EMISSIVE	0
#endif


#undef CUBE
#define CUBE 1

#if defined(CUBE) || defined(WORLDNORMAL)
#define NEEDS_TANGENT_TO_WORLD
#endif

// Variables passed from vertex to fragment shader
varying vec4 diffuse, ambient, specular;
varying vec3 tangentLightDir;
varying mat3 tbn;
varying vec3 eyeVertexPos;
#ifdef NEEDS_TANGENT_TO_WORLD
varying mat3 tangentToWorld;
#endif


attribute vec4 normal;
attribute vec3 tangent;
//attribute vec3 binormal;


// Parameters
uniform sampler2D	diffTex;
uniform sampler2D	normTex;
uniform sampler2D	specTex;
uniform sampler2D	spPowTex;
uniform sampler2D	opacTex;
uniform sampler2D	emisTex;
uniform samplerCube	cubeTex;
uniform sampler2D	maskTex;

uniform int			lightingMode;
uniform float		lightIntensity;


void VertexShaderMain()
{
	// light parameters
	// gl_FrontMaterial.diffuse and gl_FrontMaterial.ambient are premultiplied by gl_Color (see docs/glsl.txt)
	diffuse  = /*gl_FrontMaterial.diffuse * */ gl_Color * gl_LightSource[0].diffuse;
	ambient  = /*gl_FrontMaterial.ambient * */ gl_Color * (gl_LightSource[0].ambient + gl_LightSource[1].ambient + gl_LightSource[2].ambient + gl_LightModel.ambient);
	specular = gl_FrontMaterial.specular * gl_LightSource[0].specular;

	// standard transformation code
	gl_TexCoord[0] = gl_MultiTexCoord0;
	gl_Position    = ftransform();

	// get TBN in screen-space coordinate system
	// this code may not work when TBN or ModelView is not normalized (it uses transpose())
	vec3 n = normalize(normal.xyz);
	vec3 t = normalize(tangent);
	vec3 b = cross(n, t) * normal.w;
	tbn = transpose(mat3(gl_ModelViewMatrix) * mat3(t, b, n));

	// eye-space parameters
	// note: gl_LightSource.position is already transformed to eye-space
	eyeVertexPos = (gl_ModelViewMatrix * gl_Vertex).xyz;		// vertex position in eye space
	vec3 eyeLightPos  = (gl_LightSource[0].position.w == 0.0) ? gl_LightSource[0].position.xyz : (gl_LightSource[0].position.xyz - eyeVertexPos);
	tangentLightDir = normalize(tbn * eyeLightPos);

#ifdef NEEDS_TANGENT_TO_WORLD
	// matrix for conversion of tangent space vector to world space
	//?? todo: it's almost 'tbn', shuld review variable names
	tangentToWorld = mat3(t, b, n);
#endif
}


#if DIFFUSE
vec4 GetMaterialDiffuseColor(vec2 TexCoord)
{
	return texture2D(diffTex, TexCoord);
}
#endif // DIFFUSE

vec3 GetMaterialNormal(vec2 TexCoord)
{
#if 0
	return vec3(0.0, 0.0, 1.0);
#else
	return %s;
#endif
}

vec3 GetMaterialSpecularColor(vec2 TexCoord)
{
#ifndef SHOW_BUMP
	return %s;
#else
	return vec3(1.0);
#endif
}

float GetMaterialSpecularPower(vec2 TexCoord)
{
	return %s;
}

float GetMaterialOpacity(vec2 TexCoord)
{
	return %s;
}

#if EMISSIVE
vec3 GetMaterialEmissive(vec2 TexCoord)
{
	return %s;
}
#endif // EMISSIVE

vec3 GetMaterialCubemap(vec3 TexCoord)
{
	return %s;
}

float GetCubemapMask(vec2 TexCoord)
{
	return %s;
}


void PixelShaderMain()
{
	vec2 TexCoord  = gl_TexCoord[0].st;

#if DIFFUSE
	vec4 diffTexColor = GetMaterialDiffuseColor(TexCoord);
#else
	vec4 diffTexColor = vec4(1.0);
#endif

	// LIGHTING_UNLIT (Pure Anime Unlit):
	// Return pure diffuse texture multiplied by brightness control.
	// Completely bypasses normals, specular, and Fresnel.
	if (lightingMode == 0)
	{
		gl_FragColor = vec4(diffTexColor.rgb * lightIntensity, diffTexColor.a * GetMaterialOpacity(TexCoord));
		return;
	}

	vec3 normal    = GetMaterialNormal(TexCoord);
	%s
	// Reconstruct Normal Z if length is not unit (e.g. BC7/RG packed normal maps)
	float xySq = dot(normal.xy, normal.xy);
	if (xySq > 0.001 && abs(xySq + normal.z * normal.z - 1.0) > 0.05)
	{
		normal.z = sqrt(max(1.0 - xySq, 0.0001));
	}
	normal = normalize(normal);
	vec3 nLightDir = normalize(tangentLightDir);
	vec3 nEye      = normalize(tbn * -eyeVertexPos);	// eye is at (0,0,0), so direction to eye = -vertex

	// Soft wrapped diffuse for Key light (Half-Lambert)
	float NdotL0   = dot(normal, nLightDir);
	float wrapL0   = clamp((NdotL0 + 0.35) / 1.35, 0.0, 1.0);

	// Blender Studio HDRI Hemispherical Irradiance
	// World normal gives sky (+Z) vs ground (-Z) bounce
	vec3 worldNormal = normalize(tangentToWorld * normal);
	float upFactor   = clamp(worldNormal.z * 0.5 + 0.5, 0.0, 1.0);
	vec3 skyColor    = vec3(0.36, 0.38, 0.42) * lightIntensity;
	vec3 groundColor = vec3(0.18, 0.17, 0.16) * lightIntensity;
	vec3 iblAmbient  = mix(groundColor, skyColor, upFactor);

	vec3 totalLight  = iblAmbient + diffuse.rgb * wrapL0;

	// Fill light (GL_LIGHT1)
	vec3 fillDirEye = (gl_LightSource[1].position.w == 0.0) ? gl_LightSource[1].position.xyz : (gl_LightSource[1].position.xyz - eyeVertexPos);
	vec3 nFillDir   = normalize(tbn * fillDirEye);
	float NdotL1    = dot(normal, nFillDir);
	float wrapL1    = clamp((NdotL1 + 0.25) / 1.25, 0.0, 1.0);
	totalLight += gl_Color.rgb * gl_LightSource[1].diffuse.rgb * wrapL1;

	// Rim light (GL_LIGHT2)
	vec3 rimDirEye  = (gl_LightSource[2].position.w == 0.0) ? gl_LightSource[2].position.xyz : (gl_LightSource[2].position.xyz - eyeVertexPos);
	vec3 nRimDir    = normalize(tbn * rimDirEye);
	float NdotL2    = max(dot(normal, nRimDir), 0.0);
	totalLight += gl_Color.rgb * gl_LightSource[2].diffuse.rgb * (NdotL2 * 0.5);

	vec4 color = vec4(totalLight, ambient.a);

#if DIFFUSE
	color.rgb *= diffTexColor.rgb;
#endif

#ifdef SHOW_BUMP
	color = vec4(0.1, 0.1, 0.1, 1.0);
#endif

#ifdef SPECULAR
	// specular: masked by key light visibility so shadows don't glow
	vec3 specCol    = GetMaterialSpecularColor(TexCoord);
	vec3 halfVector = nLightDir + nEye;
	vec3 halfV      = normalize(halfVector);
	float NdotHV    = max(dot(normal, halfV), 0.0);
	if (length(specCol) > 0.005)
	{
		float specVis   = smoothstep(-0.05, 0.20, NdotL0);
		float specPower = clamp(GetMaterialSpecularPower(TexCoord), 1.0, 128.0);
		color.rgb += pow(NdotHV, specPower) * specCol * specVis;

		// Subtle Fresnel grazing sheen
		float fresnel   = pow(clamp(1.0 - max(dot(normal, nEye), 0.0), 0.0, 1.0), 4.0) * 0.15;
		color.rgb += specCol * fresnel * (wrapL0 * 0.7 + 0.3);
	}
#endif // SPECULAR

#ifdef SHOW_SPECULAR
	color.rgb = pow(NdotHV, GetMaterialSpecularPower(TexCoord)) * GetMaterialSpecularColor(TexCoord);
#endif

#if CUBE && !DIFFUSE
	color = vec4(0.0, 0.0, 0.0, 1.0);
#endif

#if CUBE
	vec3 reflectVec = tangentToWorld * reflect(nEye, normal);
	vec3 reflectColor = GetMaterialCubemap(-reflectVec);
	color.rgb += reflectColor * GetCubemapMask(TexCoord);
#endif

#if EMISSIVE
	color.rgb += GetMaterialEmissive(TexCoord);
#endif

	color.a = GetMaterialOpacity(TexCoord);

#ifdef NORMALMAP
	color.rgb = pow(dot(normal, nEye), 3.5) * vec3(1.0);
#endif
#ifdef WORLDNORMAL
	color.rgb = tangentToWorld * normal * 0.5 + 0.5;
#endif

	gl_FragColor = color;
}
