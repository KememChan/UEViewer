/******************************************************************************
 *	Simple per-pixel lighting shader
 *****************************************************************************/

#define SPECULAR

#ifndef TEXTURING
#define TEXTURING	1
#endif

#define PIXEL_LIGHT_DIR
#define PIXEL_HALF_VEC

// Variables passed from vertex to fragment shader
varying vec4 diffuse, ambient, specular;
varying vec3 normal;
// PIXEL_LIGHT_DIR is required for point light, but not needed for directional light
#ifndef PIXEL_LIGHT_DIR
varying vec3 lightDir;
#endif
varying vec3 position;
#ifndef PIXEL_HALF_VEC
varying vec3 halfVector;
#endif

// Parameters
#if TEXTURING
uniform sampler2D tex;
#endif

uniform bool useLighting;		// when set to "false", use vertex color only
uniform vec3 eyeLocation;
uniform int  lightingMode;
uniform float lightIntensity;


void VertexShaderMain()
{
	// vectors
	normal     = normalize(gl_NormalMatrix * gl_Normal);		// eye-space
	position   = (gl_ModelViewMatrix * gl_Vertex).xyz;			// eye-space
	// note: gl_LightSource.position is already transformed to eye-space
#ifndef PIXEL_LIGHT_DIR
	lightDir   = gl_LightSource[0].position.xyz - position;
#endif
#ifndef PIXEL_HALF_VEC
	halfVector = gl_LightSource[0].halfVector.xyz; // per-vertex ... bad
#endif
	// light parameters
	if (useLighting && lightingMode != 0)
	{
		// gl_FrontMaterial.diffuse and gl_FrontMaterial.ambient are premultiplied by gl_Color (see docs/glsl.txt)
		diffuse  = /*gl_FrontMaterial.diffuse * */ gl_Color * gl_LightSource[0].diffuse;
		ambient  = /*gl_FrontMaterial.ambient * */ gl_Color * (gl_LightSource[0].ambient + gl_LightSource[1].ambient + gl_LightSource[2].ambient + gl_LightModel.ambient);
		specular = gl_FrontMaterial.specular * gl_LightSource[0].specular;
	}
	else
	{
		diffuse  = vec4(0.0);
		ambient  = gl_Color;
		specular = vec4(0.0);
	}
	gl_TexCoord[0] = gl_MultiTexCoord0;
	gl_Position    = ftransform();
}


void PixelShaderMain()
{
#if TEXTURING
	vec4 texColor = texture2D(tex, gl_TexCoord[0].st);
#else
	vec4 texColor = vec4(1.0);
#endif

	// Anime Unlit mode: pure hand-painted diffuse without specular or normal distortion
	if (lightingMode == 0)
	{
		gl_FragColor = vec4(texColor.rgb * lightIntensity, texColor.a);
		return;
	}

#ifdef PIXEL_LIGHT_DIR
	vec3 lightDir  = (gl_LightSource[0].position.w == 0.0) ? gl_LightSource[0].position.xyz : (gl_LightSource[0].position.xyz - position);
#endif
	vec3 nLightDir = normalize(lightDir);
	vec3 n         = normalize(normal);
	float NdotL    = dot(n, nLightDir);
	float wrapL0   = clamp((NdotL + 0.35) / 1.35, 0.0, 1.0);

	// Blender Studio Hemispherical Irradiance
	float upFactor   = clamp(n.y * 0.5 + 0.5, 0.0, 1.0);
	vec3 skyColor    = vec3(0.36, 0.38, 0.42) * lightIntensity;
	vec3 groundColor = vec3(0.18, 0.17, 0.16) * lightIntensity;
	vec3 iblAmbient  = mix(groundColor, skyColor, upFactor);

	vec3 totalLight  = (useLighting ? iblAmbient : ambient.rgb) + diffuse.rgb * wrapL0;

	if (useLighting)
	{
		// Fill light
		vec3 fillDir = (gl_LightSource[1].position.w == 0.0) ? gl_LightSource[1].position.xyz : (gl_LightSource[1].position.xyz - position);
		float NdotL1 = dot(n, normalize(fillDir));
		float wrapL1 = clamp((NdotL1 + 0.25) / 1.25, 0.0, 1.0);
		totalLight += gl_Color.rgb * gl_LightSource[1].diffuse.rgb * wrapL1;

		// Rim light
		vec3 rimDir = (gl_LightSource[2].position.w == 0.0) ? gl_LightSource[2].position.xyz : (gl_LightSource[2].position.xyz - position);
		float NdotL2 = max(dot(n, normalize(rimDir)), 0.0);
		totalLight += gl_Color.rgb * gl_LightSource[2].diffuse.rgb * (NdotL2 * 0.5);
	}

	vec4 color = vec4(totalLight, ambient.a);

#if TEXTURING
	color.rgb *= texColor.rgb;
	color.a    = texColor.a;
#endif // TEXTURING

#ifdef SPECULAR
	if (useLighting && length(specular.rgb) > 0.01)
	{
		// specular
		float specularScale = 0.25;
#ifdef PIXEL_HALF_VEC
		vec3 eyeDir     = normalize(-position);
		vec3 halfVector = nLightDir + eyeDir;
#endif
		vec3 halfV      = normalize(halfVector);
		float NdotHV    = max(dot(n, halfV), 0.0);
		float specVis   = smoothstep(-0.05, 0.20, NdotL);
		color.rgb += pow(NdotHV, gl_FrontMaterial.shininess) * specular.rgb * specularScale * specVis;

		// Subtle Fresnel grazing sheen
		float fresnel = pow(clamp(1.0 - max(dot(n, eyeDir), 0.0), 0.0, 1.0), 4.0) * 0.10;
		color.rgb += specular.rgb * fresnel * (wrapL0 * 0.7 + 0.3);
	}
#endif // SPECULAR

#ifdef NORMALMAP
	gl_FragColor = vec4(n, 1.0);	// show normalmap
#else
	gl_FragColor = color;
#endif
}
